{
  "expo": {
    "name": "1pavo",
    "slug": "1pavo",
    "scheme": "unopavo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "es.unopavo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para asignarte la tienda 1pavo más cercana y llevarte el pedido."
      }
    },
    "android": {
      "package": "es.unopavo.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para asignarte la tienda 1pavo más cercana y llevarte el pedido."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1024",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
